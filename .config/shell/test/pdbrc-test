#!/bin/zsh
# Tests .pdbrc.py's commands at a breakpoint in a pytest run, in a throwaway
# HOME whose clipboard is a file.
set -e
pdbrc=${0:A:h:h}/dots/.pdbrc.py
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
mkdir -p "$tmp/home" "$tmp/bin" "$tmp/project/tests"
ln -s "$pdbrc" "$tmp/home/.pdbrc.py"
print -r -- '#!/bin/sh
cat >"$CLIPBOARD"' >"$tmp/bin/pbcopy"
chmod +x "$tmp/bin/pbcopy"
print -r -- 'import pytest


class TestOrder:
    @pytest.mark.parametrize("qty", [3])
    def test_total(self, qty):
        breakpoint()' >"$tmp/project/tests/test_order.py"
print -r -- 'breakpoint()' >"$tmp/project/script.py"

check() {
  [[ $1 == "$2" ]] && return
  print -r -- "FAILED: expected:"
  print -r -- "$2"
  print -r -- "got:"
  print -r -- "$1"
  exit 1
}

# Runs the rest of the arguments in the project, typing $1 at the breakpoint,
# then continues. Prints the output line holding $2 and what landed in the
# clipboard.
at_breakpoint() {
  local out
  rm -f "$tmp/clipboard"
  out=$(cd "$tmp/project" && print -r -- "$1"$'\nc' |
    HOME=$tmp/home PATH=$tmp/bin:$PATH CLIPBOARD=$tmp/clipboard TERM=dumb \
      uv run -q --no-project --with pytest --with pdbpp --with rich \
      "${@:3}" 2>&1) || true
  print -r -- "${(@M)${(@f)out}:#*$2*}"
  print -r -- "clipboard: $(cat "$tmp/clipboard" 2>/dev/null)"
}

check "$(at_breakpoint ynode 'test_order.py::' pytest -q -p no:cacheprovider tests)" \
  $'(Moo++) tests/test_order.py::TestOrder::test_total[3]\nclipboard: tests/test_order.py::TestOrder::test_total[3]'

check "$(at_breakpoint ynode '***' python script.py)" \
  $'(Moo++) *** Not running under pytest\nclipboard: '

print ok
