[user]
	name = Rohail Taimour
	# email intentionally omitted - set in ~/.gitconfig.local (included at the end)
	# env vars in .config/shell/local/env.sh (machine-specific, not in git)
[core]
	autocrlf = input
	editor = vim
	pager = delta
	excludesfile = ~/.gitignore
[alias]
    # while on main/master update
    pm = pull origin master
    pn = pull origin main

    # delete branches that have been merged
    po = remote prune origin
    #push current branch to origin
    poh = "!f() { git push origin HEAD \"$@\"; }; f"
    ci = !git commit -m 'ci: empty commit' --no-verify --allow-empty && git push && git reset --soft HEAD~ && git push --force-with-lease
    # Fetch origin
    fo = fetch origin

    # merge from origin directly
    mom = merge origin/master
    mon = merge origin/main

    # rebase from origin directly
    rom = rebase origin/master
    ron = rebase origin/main

    # switch to existing branch
    sw = switch

    # create and switch
    swc = switch -c

    # archive a worktree (. for this one): a dated lock, hidden from CTRL-G CTRL-W until ALT-A
    # g wt-archive <worktree> [reason...] / g wt-unarchive [worktree]
    wt-archive = "!f() { [ $# -gt 0 ] || { echo 'usage: git wt-archive <worktree> [reason...]' >&2; return 1; }; cd \"./$GIT_PREFIX\" && w=$1 && shift && git worktree lock --reason \"$(date +%F)${*:+: $*}\" \"$w\"; }; f"
    wt-unarchive = "!f() { cd \"./$GIT_PREFIX\" && git worktree unlock \"${1:-.}\"; }; f"
	ll="!git log --graph --format='%C(yellow)%h%C(red)%d%C(reset) - %C(bold green)(%ar)%C(reset) %s %C(blue)<%an>%C(reset)'"


[rerere]
	enabled = true
	autoUpdate = true
[branch]
	sort = -committerdate
[credential]
	helper = store

[interactive]
		diffFilter = delta --color-only

[delta]
		navigate = true    # use n and N to move between diff sections

		# delta detects terminal colors automatically; set one of these to disable auto-detection
		# dark = true
		#light = true
[merge]
		conflictstyle = diff3
[diff]
		colorMoved = default
	    tool = vimdiff
[http]
	postBuffer = 524288000

# vim-prompts: rules for every :Ai ask (config/agents/README.md#rules)
[vim-prompts]
	rules = ~/.config/vim-prompts/git.md

# This machine's own settings (e.g. agents.push), never committed; last, so
# they win. Set them with `git config --file ~/.gitconfig.local ...`
[include]
	path = ~/.gitconfig.local

# Last, so it wins over the machine's default identity in ~/.gitconfig.local.
[includeIf "gitdir:~/projects/personal/"]
	path = ~/.config/shell/dots/personal.gitconfig
	path = ~/.config/shell/local/personal.gitconfig
