#!/bin/bash
# Latest open PRs of the current repo, most recently updated first.
# Usage: git prs [count]   (default 20; GH_REPO=owner/name for another repo)
# One per line: number, review state, age, author, branch, title.

count="${1:-20}"

query='query($owner: String!, $name: String!, $count: Int!) {
  repository(owner: $owner, name: $name) {
    pullRequests(states: OPEN, first: $count,
                 orderBy: {field: UPDATED_AT, direction: DESC}) {
      nodes {
        number title isDraft headRefName updatedAt reviewDecision
        author { login }
      }
    }
  }
}'

# Age as 5h / 3d / 2mo
jq_age='(now - (.updatedAt | fromdateiso8601)) / 3600 | floor
  | if . < 24 then "\(.)h" elif . < 24 * 60 then "\(. / 24 | floor)d"
    else "\(. / 24 / 30 | floor)mo" end'

gh api graphql -F owner='{owner}' -F name='{repo}' -F count="$count" \
    -f query="$query" --jq "
  .data.repository.pullRequests.nodes[]
  | [\"#\(.number)\",
     (if .isDraft then \"draft\" else
        {APPROVED: \"approved\", CHANGES_REQUESTED: \"changes\",
         REVIEW_REQUIRED: \"review\"}[.reviewDecision // \"\"] // \"-\" end),
     ($jq_age), (.author.login // \"ghost\"), .headRefName[0:30], .title]
  | @tsv" | column -t -s $'\t'
