#!/bin/bash
# Delete merged branch

# Load git helper functions
BASE="${SHELL_CONFIG_BASE:-$HOME/.config/shell}"
[ -r "$BASE/common/git.sh" ] && . "$BASE/common/git.sh"

bare_dir=$(git_get_bare_dir)
default_branch=$(git_get_default_branch "$bare_dir")

if [ -z "$default_branch" ]; then
    echo "Error: Could not detect default branch"
    exit 1
fi

# for-each-ref, not `git branch`: its `*`/`+` markers break parsing.
# Skip the default branch and anything checked out in a worktree.
git for-each-ref --merged "origin/$default_branch" \
    --format='%(refname:short)%09%(worktreepath)' refs/heads \
    | while IFS=$'\t' read -r branch worktree; do
        [ "$branch" = "$default_branch" ] && continue
        [ -n "$worktree" ] && continue
        git branch -d "$branch"
    done
