#!/bin/bash
# Download the artifacts of a GitHub Actions run with gh, one directory (or
# zip) per artifact, and print each downloaded path on stdout.

set -euo pipefail

usage() {
    cat <<'USAGE'
usage: git artifacts [options]

Downloads artifacts from the latest successful run on the default branch of
this repository, one per line on stdout as DIR/NAME (or DIR/NAME.zip with -z).

  -R owner/repo  repository (default: the one you're in)
  -w workflow    only runs of this workflow (name, file or ID)
  -b branch      only runs on this branch (default: the default branch)
  -s status      run status or conclusion (default: success)
  -r run-id      this run; skips the lookup and -w, -b, -s
  -n name        artifact name or glob; repeat for more (default: all)
  -D dir         download into dir (default: .)
  -z             keep each artifact as its zip instead of extracting it
  -l             list the run's artifact names instead of downloading
  -h, --help     show this help

  git artifacts -w tests.yml -n coverage -z
  git artifacts -R owner/api -w ci -n 'coverage-*' -D ~/coverage/api
USAGE
}

# Load git helper functions
BASE="${SHELL_CONFIG_BASE:-$HOME/.config/shell}"
[ -r "$BASE/common/git.sh" ] && . "$BASE/common/git.sh"

[ "${1:-}" = --help ] && { usage; exit 0; }

repo='' workflow='' branch='' status=success run='' dir=. zip='' list=''
names=()
while getopts R:w:b:s:r:n:D:zlh opt; do
    case $opt in
        R) repo=$OPTARG ;;
        w) workflow=$OPTARG ;;
        b) branch=$OPTARG ;;
        s) status=$OPTARG ;;
        r) run=$OPTARG ;;
        n) names+=("$OPTARG") ;;
        D) dir=$OPTARG ;;
        z) zip=1 ;;
        l) list=1 ;;
        h) usage; exit 0 ;;
        *) usage >&2; exit 2 ;;
    esac
done
shift $((OPTIND - 1))
[ $# -eq 0 ] || { usage >&2; exit 2; }

die() { echo "git artifacts: $*" >&2; exit 1; }

here=''
if [ -z "$repo" ]; then
    here=1
    repo=$(gh repo view --json nameWithOwner -q .nameWithOwner) \
        || die "no -R and no GitHub repository here"
fi

if [ -z "$run" ]; then
    if [ -z "$branch" ]; then
        # Here, the git helper; elsewhere (-R), ask GitHub
        if [ -n "$here" ]; then
            branch=$(git_get_default_branch "$(git_get_bare_dir)")
        fi
        [ -n "$branch" ] || branch=$(gh repo view "$repo" \
            --json defaultBranchRef -q .defaultBranchRef.name)
    fi
    lookup=(gh run list -R "$repo" -b "$branch" -s "$status" -L 1
            --json databaseId -q '.[0].databaseId')
    [ -n "$workflow" ] && lookup+=(-w "$workflow")
    run=$("${lookup[@]}")
    [ -n "$run" ] || die "no $status run on $branch${workflow:+ of $workflow} in $repo"
fi
echo "run $run of $repo" >&2

# id<TAB>name of the run's unexpired artifacts matching any -n
matches=$(gh api --paginate "repos/$repo/actions/runs/$run/artifacts" \
    -q '.artifacts[] | select(.expired | not) | "\(.id)\t\(.name)"' |
    while IFS=$'\t' read -r id name; do
        if [ ${#names[@]} -eq 0 ]; then
            printf '%s\t%s\n' "$id" "$name"
            continue
        fi
        for pat in "${names[@]}"; do
            # shellcheck disable=SC2053 # the pattern is a glob on purpose
            if [[ $name == $pat ]]; then
                printf '%s\t%s\n' "$id" "$name"
                break
            fi
        done
    done)
[ -n "$matches" ] || die "no matching artifacts in run $run"

if [ -n "$list" ]; then
    cut -f2 <<<"$matches"
    exit 0
fi

mkdir -p "$dir"
while IFS=$'\t' read -r id name; do
    if [ -n "$zip" ]; then
        out=$dir/$name.zip
        gh api "repos/$repo/actions/artifacts/$id/zip" >"$out"
    else
        out=$dir/$name
        rm -rf "$out"
        gh run download "$run" -R "$repo" -n "$name" -D "$out"
    fi
    printf '%s\n' "$out"
done <<<"$matches"
