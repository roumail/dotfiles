# The python stack: include it from a repo's or a group's config to turn it on
# (stacks/README.md). local/ holds this machine's python-local.md, unpacked by
# install.sh from python-local.md.example.
[vim-prompts]
	task-rules = ~/.config/vim-prompts/stacks/python/task-rules
	personas = ~/.config/vim-prompts/stacks/python/personas
	task-rules = ~/.config/vim-prompts/local
